{
  "name": "arxiv-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server exposing arXiv as a browsable virtual filesystem via OAI-PMH + Atom API",
  "keywords": [
    "pi-package",
    "mcp",
    "arxiv",
    "research",
    "papers",
    "academic",
    "llm",
    "ai",
    "virtual-filesystem",
    "model-context-protocol"
  ],
  "scripts": {
    "start": "node --experimental-strip-types server.ts",
    "dev": "node --watch --experimental-strip-types server.ts"
  },
  "pi": {
    "extensions": ["./integrations/pi-extension.ts"]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^4.5.3",
    "node-html-parser": "^7.1.0",
    "pdf-parse": "^2.4.5",
    "tar-stream": "^3.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@types/node": "^25.9.1",
    "@types/tar-stream": "^3.1.4",
    "typebox": "^1.1.38"
  },
  "engines": {
    "node": ">=22"
  }
}
